PICKER_IMAGE=ghcr.io/wjdecorte/picker:latest
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# NAS host port; container port remains 3000.
APP_PORT=8756
# Replace YOUR_NAS_IP with the NAS private IP or local hostname.
APP_ORIGIN=http://YOUR_NAS_IP:8756
RESULTS_SERVICE_KEY=

# Server-side LLM configuration. Never use NEXT_PUBLIC_ for API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
