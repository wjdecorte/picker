PICKER_IMAGE=ghcr.io/wjdecorte/picker:latest
# Use a long random URL-safe password (letters, digits, hex); do not commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8756
# On Synology, replace localhost with the NAS private IP or local hostname.
APP_ORIGIN=http://localhost:8756
POSTGRES_PORT=5433
# Local npm commands use compose.dev.yaml to reach PostgreSQL.
DATABASE_URL=postgresql://picker:replace-with-a-long-random-password@127.0.0.1:5433/picker
# Optional secret for future scheduled score-refresh callers. Never put in NEXT_PUBLIC_*.
RESULTS_SERVICE_KEY=

# Server-side LLM configuration. Never use NEXT_PUBLIC_ for API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
